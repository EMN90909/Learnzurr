# App Environment
APP_ENV=development
PORT=3000
API_PORT=8081
PUBLIC_API_BASE=/api

# JWT Secret (At least 32 characters)
LEARNZUR_JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars

# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Redis Configuration
REDIS_URL=redis://localhost:6379

# hCaptcha Configuration
PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
HCAPTCHA_BYPASS_IN_DEV=true

# Email Configuration (Resend or SMTP)
# If using Resend:
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# If using SMTP (fallback/direct):
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=noreply@learnzur.co.ke

# AI Moderation Provider (gemini | openrouter | deepseek)
FLAG_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key