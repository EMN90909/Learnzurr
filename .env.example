PORT=8081
APP_URL=http://localhost:8081
CLIENT_ORIGIN=http://localhost:5173

# Browser-safe Supabase values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase values. Enable email confirmation and configure custom SMTP/templates in Supabase Auth.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only Paystack credential
PAYSTACK_SECRET_KEY=sk_test_replace_me

# SMTP used for scheduled-class messages. Supabase SMTP sends auth verification and invitation links.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Learnzurr <no-reply@example.com>

# Browser web push
VAPID_SUBJECT=mailto:support@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Go signaling service
SIGNALING_URL=ws://localhost:8090/ws
SIGNAL_PORT=8090
SIGNALING_SHARED_SECRET=replace-with-a-long-random-secret
SIGNAL_ALLOWED_ORIGINS=http://localhost:5173
SIGNAL_ALLOW_INSECURE=false

# ICE configuration. STUN is first; TURN remains opt-in for restrictive NATs.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Optional embedded Pion STUN/TURN server in the Go signaling process.
TURN_ENABLE=false
TURN_PUBLIC_IP=
TURN_PORT=3478
TURN_REALM=learnzurr
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
