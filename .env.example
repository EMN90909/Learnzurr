APP_NAME=Learnzur
APP_ENV=development
PUBLIC_APP_URL=http://localhost:8080
PUBLIC_API_BASE=/api
FRONTEND_ORIGIN=http://localhost:3000
API_PORT=8080
DATABASE_URL=postgres://postgres:postgres@postgres:5432/learnzur?sslmode=disable
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
PIN_PEPPER=
AES_KEY_BASE64=
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Learnzur <noreply@learnzur.app>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
FLAG_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
HCAPTCHA_BYPASS_IN_DEV=false
RENDER_HEALTH_PATH=/api/health
ORACLE_SHAPE=VM.Standard.A1.Flex

# Security hardening
LEARNZUR_JWT_SECRET=
LEARNZUR_EMAIL_PREVIEW=false
LEARNZUR_INSECURE_DEV_COOKIES=false
SUPABASE_ANON_KEY=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Secure cookie/session settings
LEARNZUR_COOKIE_SAMESITE=Lax
LEARNZUR_REFRESH_COOKIE=learnzur_refresh
LEARNZUR_CSRF_COOKIE=learnzur_csrf
LEARNZUR_DEVICE_COOKIE=learnzur_device
LEARNZUR_ROLE_HINT_COOKIE=learnzur_role_hint
LEARNZUR_THEME_COOKIE=learnzur_theme
LEARNZUR_LOCALE_COOKIE=learnzur_locale
LEARNZUR_LAST_DASHBOARD_COOKIE=learnzur_last_dashboard
LEARNZUR_OFFLINE_COOKIE=learnzur_offline_mode
