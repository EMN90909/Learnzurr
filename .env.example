# Learnzur local development environment
# Frontend talks to Go API only. Go API talks to Supabase PostgreSQL, Redis, M-Pesa, mail and push providers.

PUBLIC_API_BASE_URL=/api
PUBLIC_SITE_URL=http://localhost
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

APP_ENV=development
API_PORT=8080
JWT_SECRET=change-me-use-a-long-random-secret
DATABASE_URL=postgres://postgres:postgres@postgres:5432/learnzur?sslmode=disable
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
CORS_ALLOWED_ORIGIN=http://localhost

DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://your-domain.com/api/mearn/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
MEDIA_STORAGE_ROOT=/var/learnzur/media

# Single-container deployment
PORT=10000
HOST=0.0.0.0
FRONTEND_PORT=3000
API_PORT=8080
PUBLIC_API_BASE_URL=/api
