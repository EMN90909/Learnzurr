FROM golang:1.23-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum* ./
RUN go mod download
COPY backend/ ./
RUN go build -o /out/learnzur-api ./cmd/api && go build -o /out/learnzur-auth ./cmd/auth && go build -o /out/learnzur-worker ./cmd/worker
FROM alpine:3.21
RUN adduser -D -H learnzur
USER learnzur
WORKDIR /app
COPY --from=build /out/ /app/
EXPOSE 8080 8082
CMD ["/app/learnzur-api"]
